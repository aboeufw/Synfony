{% trans_default_domain 'bl' %}
<div id="bl-container" aria-busy="true" aria-live="polite">
    <div id="loader" class="loader" style="text-align: center">
        <img src="data:image/png;base64,{{ loadingBase64 }}"><br/>
        {{ 'Loading...'|trans }}
    </div>
</div>
{% if type == 'html' %}
<script>
    (async () => {
        const container = document.getElementById('bl-container');
        try {
            const res = await fetch('{{ path('app_bl_index_fragment', { id: id, track: track, type: 'html' }) }}', { headers: { 'X-Requested-With': 'XMLHttpRequest' }});
            if (!res.ok) throw new Error('HTTP '+res.status);
            const html = await res.text();
            container.setAttribute('aria-busy', 'false');
            container.innerHTML = html;
        } catch (e) {
            container.setAttribute('aria-busy', 'false');
            container.innerHTML = '<p>Oups, une erreur est survenue. Veuillez réessayer.</p>';
        }
    })();
</script>
{% else %}
    <iframe
        id="pdf-frame"
        title="BL PDF"
        style="width:100%; height:90vh; border:0;"
        src="{{ path('app_bl_index_fragment', { id: id, track: track, type: 'pdf' }) }}">
    </iframe>
    <script>
        const frame = document.getElementById('pdf-frame');
        const loader = document.getElementById('loader');
        window.addEventListener('load', () => {
            loader.style.display = 'none';
            frame.style.display = 'block';
        });
    </script>
{% endif %}
